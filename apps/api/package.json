{
  "name": "@mmsc/api",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:check": "tsx src/database/migrate.ts --check",
    "db:seed": "tsx src/database/seed.ts",
    "db:demo:reset": "tsx src/database/demo-reset.ts",
    "db:demo:validate": "tsx src/database/demo-validate.ts",
    "db:reset:student-lifecycle": "tsx src/database/reset-student-lifecycle.ts",
    "db:reset:test-rfid": "tsx src/database/reset-test-rfid.ts",
    "db:validate:library-group2": "tsx src/database/validate-library-group2.ts",
    "db:validate:library-group3": "tsx src/database/validate-library-group3.ts",
    "db:validate:library-group4": "tsx src/database/validate-library-group4.ts",
    "db:validate:library-group5": "tsx src/database/validate-library-group5.ts",
    "db:validate:library-group6": "tsx src/database/validate-library-group6.ts",
    "db:validate:library-group7": "tsx src/database/validate-library-group7.ts",
    "db:validate:library-manual-extension": "tsx src/database/validate-library-manual-extension.ts",
    "db:validate:library-manual-extension2": "tsx src/database/validate-library-manual-extension2.ts"
    ,"db:validate:computer-lab-rbac": "tsx src/database/validate-computer-lab-rbac.ts",
    "db:validate:computer-lab-runtime": "tsx src/database/validate-computer-lab-runtime.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "sharp": "^0.34.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
